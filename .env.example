# Local-only build by default. Set a registry reference for pull/recreate upgrades.
AGENT_IMAGE=ai-agent:local
# Must match ownership of Linux bind-mounted projects. Changing these rebuilds the image.
AGENT_UID=1000
AGENT_GID=1000
SSH_BIND_ADDRESS=127.0.0.1
SSH_PORT=2222
AUTHORIZED_KEYS_FILE=./runtime/authorized_keys
# Existing absolute directories; never point these at your whole home.
PROJECT_ONE=/absolute/path/to/project-one
PROJECT_TWO=/absolute/path/to/project-two
